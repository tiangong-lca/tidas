{
  "name": "tidas-docs",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "verify:out": "node scripts/verify-out.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "test": "node --test scripts/check-env.test.mjs scripts/content-contract.test.mjs scripts/toolchain-contract.test.mjs",
    "test:env": "node --test scripts/check-env.test.mjs",
    "test:toolchain": "node --test scripts/toolchain-contract.test.mjs",
    "test:content": "node --test scripts/content-contract.test.mjs",
    "lint": "pnpm exec markdownlint-cli2 '**/*.md' '**/*.mdx' '#node_modules' '#content/docs/.source'"
  },
  "dependencies": {
    "@fumadocs/language": "0.2.2",
    "algoliasearch": "5.57.0",
    "fumadocs-core": "16.15.0",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "markdownlint-cli2": "0.23.2",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
